# ===== LifeOS AI — Environment File (نسخة مثال) =====
# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env إلى GitHub أبداً.

# ===== أسهل طريقة للتهيئة =====
# يمكنك وضع كل الإعدادات في متغير واحد LIFEOS_SETTINGS بصيغة JSON،
# وهذا يفي النشر على Vercel بإضافة متغير واحد فقط بدل 7 متغيرات.
# مثال:
# LIFEOS_SETTINGS={"DATABASE_URL":"postgresql://...","TRUST_WALLET_ADDRESS":"T...","AI_API_KEY":"gsk_..."
#   ,"AI_ENABLED":"true","OWNER_EMAIL":"owner@lifeos.app","OWNER_PASSWORD":"...","JWT_SECRET":"..."}

# المنفذ (للتشغيل المحلي)
PORT=3000

# ===== قاعدة البيانات =====
# اتركها فارغة عند التشغيل محلياً (سيستخدم SQLite).
# عند النشر على Vercel: أنشئ Postgres (Neon/Supabase/Prisma) وضع هنا سلسلة الاتصال، مثال:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# للبيئة المحلية فقط: اجعلها true حتى لا تحاول الاتصال بالسحابة من هذا الجهاز.
FORCE_SQLITE=true

# المفتاح السري لتوقيع التوكنات (غيّره لقيمة عشوائية طويلة)
JWT_SECRET=change-me-to-a-long-random-secret

# المالك (لوحة المشرف)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-strong-password

# عنوان محفظة Trust Wallet لاستقبال USDT على شبكة TRC20
# يبدأ بحرف T. مثال: T......
TRUST_WALLET_ADDRESS=TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# سعر الاشتراك الشهري بالدولار (بالقيمة الاسمية بالدولار) — للإظهار
PRICE_PRO=9.99
PRICE_LIFE=19.99

# ===== عرض الإطلاق (كوبون) =====
LAUNCH_COUPON=LIFE20
LAUNCH_COUPON_PERCENT=50

# ===== الذكاء الاصطناعي (اختياري) =====
# إذا ترك التالف فارغاً، سيستخدم النظام المساعد الداخلي (محلي/حسب القواعد).
# يدعم أي مزوّد متوافق مع OpenAI: OpenAI, Groq, OpenRouter, Ollama...
# انتبه: إذا كان مفتاحك يبدأ بـ gsk_ (Groq) أو sk-or- (OpenRouter)،
# سيكتشفه النظام تلقائياً ولن تحتاج AI_BASE_URL أو AI_MODEL.
AI_ENABLED=true
AI_API_KEY=
# اختياري:
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
# false = لا تستخدم ردود جاهزة عند فشل المزود؛ يعرض الخطأ الحقيقي.
AI_ALLOW_FALLBACK=false

# Email verification (choose one):
# 1) Resend: https://resend.com — set RESEND_API_KEY + MAIL_FROM
# 2) SMTP (e.g. Gmail app password): SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASS=16char
RESEND_API_KEY=
MAIL_FROM=LifeOS AI <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "1" disables real email, logs code (local testing only)
MAIL_DEV=
# "false" hides dev verification code when no real mail provider is configured
ALLOW_DEV_VERIFY=true
